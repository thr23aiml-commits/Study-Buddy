# Copy this file to .env and fill in real values. NEVER commit .env.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=replace-me-with-a-long-random-string

# True only for local development. Must be False in production.
DEBUG=True

# Comma-separated hostnames the site may be served from.
ALLOWED_HOSTS=localhost,127.0.0.1

# Get a key from Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Per-IP limit for all AI endpoints combined (format: number/period, e.g. 10/m, 100/h).
AI_RATE_LIMIT=10/m

# Leave unset to use SQLite. For PostgreSQL use:
# DATABASE_URL=postgres://user:password@localhost:5432/quizdb
